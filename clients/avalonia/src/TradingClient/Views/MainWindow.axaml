<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TradingClient.ViewModels"
        xmlns:views="using:TradingClient.Views"
        x:Class="TradingClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="2PC Trading Client"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="600">

    <DockPanel>
        <!-- Top status bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="2PC Trading Client"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right"
                           Margin="0,0,8,0"
                           Text="{Binding StatusBarMessage}"
                           VerticalAlignment="Center"
                           Foreground="{Binding IsCoordinatorUp, Converter={x:Static views:BoolToBrushConverter.Instance}}"/>
            </DockPanel>
        </Border>

        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Race demo"
                        Command="{Binding RaceDemo.RunCommand}"
                        IsEnabled="{Binding !IsCoordinatorUp, Converter={x:Static views:InverseBoolConverter.Instance}}"/>
                <Button Content="Health check"
                        Command="{Binding DevTools.CheckHealthCommand}"/>
                <Button Content="Cancel selected"
                        Command="{Binding OrderDetail.CancelCommand}"/>
            </StackPanel>
        </Border>

        <!-- Two-pane body -->
        <Grid ColumnDefinitions="320,*">
            <views:OrderListView Grid.Column="0"
                                 DataContext="{Binding OrderList}"/>
            <views:OrderDetailView Grid.Column="1"
                                   DataContext="{Binding OrderDetail}"/>
        </Grid>
    </DockPanel>
</Window>
