yarn-debug.log
yarn-error.log

# HTMX frontend cache
web/templates/*.html~

# Backup files
*.bak
*.backup

# Coverage reports
coverage.html
coverage.out

# Go build cache (usually in GOPATH, but just in case)
.cover/

